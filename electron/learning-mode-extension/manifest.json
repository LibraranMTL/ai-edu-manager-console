{
  "manifest_version": 3,
  "name": "AI教育管家专注模式",
  "version": "1.0.2",
  "description": "应用本机专注模式的站点限制和课程例外。",
  "key": "",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
