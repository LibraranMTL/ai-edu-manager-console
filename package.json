{
  "name": "edu-manager-launcher",
  "version": "0.7.16",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean:dist && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "build:win": "pnpm build && electron-builder --win portable --x64",
    "license-admin:desktop": "electron tools/license-admin-app",
    "build:license-admin": "electron-builder --projectDir tools/license-admin-app --win portable --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.qxmatrix.edumanager.desktop",
    "productName": "AI Education Manager Console",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "AI-edu-manager-console-Windows-${version}.${ext}",
      "icon": "public/brand/robogala.ico",
      "target": [
        "portable"
      ]
    }
  }
}
