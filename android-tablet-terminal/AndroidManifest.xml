<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qxmatrix.eduterminal"
    android:versionCode="58"
    android:versionName="0.4.8">

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN" />
        </intent>
        <package android:name="com.tencent.wework" />
        <package android:name="com.tencent.weworklocal" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.minihd.qq" />
        <package android:name="com.tencent.tim" />
        <package android:name="com.tencent.qclaw" />
        <package android:name="com.tencent.qclaw.android" />
        <package android:name="com.tencent.qclawapp" />
        <package android:name="com.qclaw.app" />
        <package android:name="com.tencent.claw" />
        <package android:name="com.tencent.marvis" />
        <package android:name="com.tencent.marvis.android" />
        <package android:name="com.tencent.marvisapp" />
        <package android:name="com.marvis.app" />
        <package android:name="com.tencent.jarvis" />
        <package android:name="com.tencent.ai.marvis" />
        <package android:name="com.tencent.aigc.marvis" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wxwork" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqq" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="qclaw" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="marvis" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/brand_logo_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.qxmatrix.eduterminal.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>

