{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.greatbg.com/schemas/student-course-projection.v2.json",
  "title": "StudentCourseProjectionV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostId", "studentId", "projectionRevision", "manifestRevision", "policyRevision", "generatedAt", "expiresAt", "cloudFreshUntil", "courses", "tombstones", "disclaimer"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "hostId": { "type": "string", "minLength": 1 },
    "studentId": { "type": "string", "minLength": 1 },
    "projectionRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifestRevision": { "type": "string" },
    "policyRevision": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "cloudFreshUntil": { "type": "string", "format": "date-time" },
    "courses": { "type": "array", "items": { "type": "object" } },
    "tombstones": { "type": "array", "items": { "type": "object" } },
    "disclaimer": { "type": "string", "minLength": 1 }
  }
}
