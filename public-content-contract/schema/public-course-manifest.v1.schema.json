{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.greatbg.com/schemas/public-course-manifest.v1.json",
  "title": "PublicCourseManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "schemaVersion", "manifestId", "manifestRevision", "releaseId", "audienceKey", "audienceRevision", "selectionReason", "issuedAt", "effectiveAt", "expiresAt", "previousRevision", "minClientVersions", "courses", "assets", "tombstones", "keyId", "signatureAlgorithm", "signature"],
  "properties": {
    "contractId": { "const": "edu-manager.public-course-mvp.v1" },
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "manifestRevision": { "type": "string", "pattern": "^manifest-rev-[a-f0-9]{32}$" },
    "releaseId": { "type": "string", "minLength": 3, "maxLength": 160 },
    "audienceKey": { "type": "string", "minLength": 1, "maxLength": 120 },
    "audienceRevision": { "type": "string", "minLength": 1, "maxLength": 120 },
    "selectionReason": { "type": "string", "minLength": 1, "maxLength": 320 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "previousRevision": { "type": "string", "maxLength": 180 },
    "minClientVersions": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 40 } },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["courseId", "courseRevision", "sourceCategory", "localizationRevision", "locale", "title", "summary", "provider", "launchUrl", "allowedHosts", "coverAssetRevisionId", "gradeBands", "ageRange", "legalNotice", "accountRequirement", "defaultEnabled", "offlineOpenTtlSeconds", "minClientVersions"],
        "properties": {
          "courseId": { "type": "string", "pattern": "^(platform|tenant):[a-z0-9][a-z0-9-]{2,120}$" },
          "courseRevision": { "type": "string", "minLength": 1, "maxLength": 120 },
          "sourceCategory": { "type": "string", "minLength": 1, "maxLength": 60 },
          "localizationRevision": { "type": "string", "minLength": 1, "maxLength": 120 },
          "locale": { "enum": ["zh-CN", "zh-TW", "en-US", "en-GB", "fr", "es", "es-419", "ja", "ko", "vi", "ms"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1600 },
          "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
          "launchUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "allowedHosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" } },
          "coverAssetRevisionId": { "type": "string", "pattern": "^asset-rev-[a-f0-9]{64}$" },
          "gradeBands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 40 } },
          "ageRange": { "type": "string", "maxLength": 80 },
          "legalNotice": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "accountRequirement": { "type": "string", "maxLength": 320 },
          "defaultEnabled": { "type": "boolean" },
          "offlineOpenTtlSeconds": { "type": "integer", "minimum": 0, "maximum": 21600 },
          "minClientVersions": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 40 } }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "assetRevisionId", "sha256", "bytes", "mimeType", "downloadPath"],
        "properties": {
          "assetId": { "type": "string" },
          "assetRevisionId": { "type": "string", "pattern": "^asset-rev-[a-f0-9]{64}$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 5242880 },
          "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
          "downloadPath": { "type": "string", "pattern": "^/v2/public-content/assets/asset-rev-[a-f0-9]{64}$" }
        }
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["courseId", "withdrawnAt", "reasonCode", "severity", "replacementCourseId"],
        "properties": {
          "courseId": { "type": "string" },
          "withdrawnAt": { "type": "string", "format": "date-time" },
          "reasonCode": { "type": "string" },
          "severity": { "type": "string" },
          "replacementCourseId": { "type": "string" }
        }
      }
    },
    "keyId": { "type": "string", "minLength": 3, "maxLength": 120 },
    "signatureAlgorithm": { "const": "RSA-SHA256" },
    "signature": { "type": "string", "minLength": 64 }
  }
}
